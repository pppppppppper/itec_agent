# ── 智图伙伴 · 环境变量 ─────────────────────────────────────────
# 复制成 .env（.env 已在 .gitignore 里，不会被提交）

# 个人 API Key（设置 → API Key，形如 mysta_…）
# ⚠️ 只放在服务器和本地。绝不要加 VITE_ 前缀 —— 加了就会被打进浏览器包。
OPENHEX_API_KEY=

# 平台 API 地址，走代理时改这里
OPENHEX_API_BASE=https://api.openhex.tech

# 前端要用的 Agent ID（这个不是密钥，可以进浏览器）
# 留空 = mock 模式，用本地 fixture 数据跑通全部界面
VITE_AGENT_ID=

# 强制开关：'1' 永远 mock，'0' 表示只要填了 VITE_AGENT_ID 就走真链路
VITE_MOCK=

# 服务端口（国内 80/443 绑域名要备案，所以用高位端口）
PORT=8080
